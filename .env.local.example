# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key (Supabase dashboard → Project Settings → API). Server-only:
# powers the ESPN sync. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret protecting /api/sync/nfl. Vercel cron sends it automatically
# as a Bearer token; set the same value in Vercel env vars. Any long random
# string works: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Web push (notifications). Generate a pair once with:
#   npx web-push generate-vapid-keys
# The public key is inlined into the browser bundle at build time
# (NEXT_PUBLIC_); the private key is server-only — never give it a
# NEXT_PUBLIC_ prefix. VAPID_SUBJECT is a contact URI, e.g.
# mailto:you@example.com. With ANY of the three unset, the whole push
# feature no-ops silently, so deploys are safe before keys exist.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com
